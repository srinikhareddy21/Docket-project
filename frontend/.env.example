# Base URL of the DOCKET API. Keep '/api' to use the Vite dev proxy (recommended; see vite.config.js).
VITE_API_BASE_URL=/api
# Where the dev proxy forwards /api (the Spring Boot server)
VITE_PROXY_TARGET=http://localhost:8080

# Optional: Chrome Web Store listing URL. When set, Settings shows an Add to Chrome button.
VITE_CHROME_STORE_URL=
