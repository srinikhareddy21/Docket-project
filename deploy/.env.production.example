# Copy to deploy/.env.production (git-ignored) and fill in EVERY value. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# --- Public address and HTTPS (Caddy gets a free certificate for DOMAIN automatically) ---
DOMAIN=docket.example.com
ACME_EMAIL=you@example.com

# --- Database (used by both the mysql and backend containers) ---
DB_NAME=docket
DB_USER=docket
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Backend. The prod profile refuses to start if any of these are unsafe. ---
JWT_SECRET=
FRONTEND_URL=https://docket.example.com
CORS_ALLOWED_ORIGINS=https://docket.example.com
COOKIE_SECURE=true
FORWARD_HEADERS_STRATEGY=native

# --- Mail (a real SMTP provider; password-reset and reminder emails go through it) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@docket.example.com

# --- Optional: Google Calendar. Leave blank and the Calendar page says "not set up on this server". ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://docket.example.com/api/integrations/google-calendar/callback
TOKEN_ENCRYPTION_KEY=

# --- Optional: Chrome extension origin(s), comma separated (chrome-extension://<id>) ---
EXTENSION_ORIGINS=

# --- Optional tuning (the defaults are right for most deployments; uncomment to change) ---
# UNDO_WINDOW=5m                # how long after deleting an application "Undo" still works
# DELETED_RETENTION=30d         # how long a deleted application is kept before it is permanently purged (with its files)
# RATE_LIMIT_IP_MAX=30          # credential requests per IP per 10 minutes. Leave at 30 in production.
# STORAGE_DIR is set to /data/uploads by the backend image; it is the docket-uploads volume. Back it up with the database.
