# Environment variables for a single Render Web Service (Docker).
# Set these in the Render dashboard → Environment. Do not commit real values.

# --- Required ---
# Render injects PORT automatically; do not override unless you know you need to.
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=                 # openssl rand -base64 48
COOKIE_SECURE=true
FORWARD_HEADERS_STRATEGY=native

# Public site URL (your Render service URL or custom domain). Must be https://
FRONTEND_URL=https://YOUR_SERVICE.onrender.com
CORS_ALLOWED_ORIGINS=https://YOUR_SERVICE.onrender.com

# --- MySQL (Render MySQL or any managed MySQL) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_ALLOW_PK_RETRIEVAL=false
JPA_DDL_AUTO=validate

# --- Mail (required when SPRING_PROFILES_ACTIVE=prod — ProductionGuard refuses localhost/MailHog) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@your-domain.com

# --- Optional: Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_SERVICE.onrender.com/api/integrations/google-calendar/callback
TOKEN_ENCRYPTION_KEY=       # openssl rand -base64 32

# --- Optional: Chrome extension ---
EXTENSION_ORIGINS=

# File uploads inside the container (use a Render disk mount if you need persistence)
STORAGE_DIR=/data/uploads
