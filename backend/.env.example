# Copy to .env (git-ignored). Never commit real values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=docket
DB_USER=docket
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# REQUIRED. Base64, at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=

# Where the React app lives (used in password-reset links and CORS).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true in production (HTTPS only). false for http://localhost.
COOKIE_SECURE=false

# Mail. Defaults point at the MailHog container from docker-compose (http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@docket.local

# Set to "native" when running behind a reverse proxy so rate limiting sees real client IPs.
FORWARD_HEADERS_STRATEGY=none
# Escape hatch if Hibernate schema validation misfires: set to "none".
JPA_DDL_AUTO=validate

# --- Phase 7 ---
# Google Calendar (optional). Leave blank and the Calendar page says "not configured". See README "Google Calendar setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google-calendar/callback
# Encrypts the stored Google refresh token. Required for Google Calendar.  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Chrome extension origin(s), comma separated, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop (optional)
# Optional extra origins for the Chrome extension API. chrome-extension://* is always allowed.
EXTENSION_ORIGINS=
